{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "Backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/(ping|login|register|me|logout|forgot-password|verify-otp|reset-password|telegram-link|telegram-verification-code)",
      "destination": "/api/index.js"
    },

    {
      "source": "/transaction(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/notifications(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/telegram-webhook",
      "destination": "/api/index.js"
    },
    {
      "source": "/accounts(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/api/index.js"
    },

    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
